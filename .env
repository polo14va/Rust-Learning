DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/rust_db
REDIS_URL=redis://host.docker.internal/
JWT_SECRET=change_this_secret_in_production_min_32_chars
JWT_EXPIRATION_MINUTES=3600
RATE_LIMIT_PER_SECOND=10000
OIDC_ISSUER="http://localhost:3000"
DEFAULT_USER_SCOPE="openid profile email offline_access dashboard.read"
RESOURCE_AUDIENCE="first-party"
COOKIE_SECURE="false"
COOKIE_SAMESITE="Strict"
FRAME_ANCESTORS="'self' http://localhost:8000 http://127.0.0.1:8000"
REFERRER_POLICY="strict-origin-when-cross-origin"
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
ENABLE_HSTS="false"
HSTS_MAX_AGE="63072000"
REQUIRE_PKCE="true"
PUBLIC_CLIENTS="public-web-client"
DASHBOARD_SCOPE="dashboard.read"
ROUTE_SCOPE_MAP="/dashboard=dashboard.read;/users=users.read;/userinfo=openid;/introspect=introspect;/revoke=revoke"
ROUTE_ROLE_MAP="/users=admin;/introspect=service,admin;/revoke=service,admin"
CLIENT_SCOPE_MAP="demo-client=openid profile email offline_access dashboard.read users.read;service-client=metrics.read introspect revoke"
CLIENT_ROLE_MAP="demo-client=user;service-client=service"
SENSITIVE_SCOPES="users.read metrics.read"
SENSITIVE_SESSION_MAX_AGE_SECONDS="300"
INTROSPECT_SCOPE="introspect"
REVOKE_SCOPE="revoke"
INTROSPECT_ROLES="service,admin"
REVOKE_ROLES="service,admin"
ENABLE_REGISTRATION="true"
NONCE_TTL_SECONDS="600"
BIND_REFRESH_TOKEN_UA="true"
BIND_REFRESH_TOKEN_SESSION="true"
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="10"
PASSWORD_MIN_LENGTH="10"
PASSWORD_REQUIRE_UPPER="true"
PASSWORD_REQUIRE_LOWER="true"
PASSWORD_REQUIRE_DIGIT="true"
PASSWORD_REQUIRE_SPECIAL="true"
REFRESH_TOKEN_TTL_DAYS="30"
SESSION_TTL_MINUTES="1440"
